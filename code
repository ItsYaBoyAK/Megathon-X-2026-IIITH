# --- Fast Caching for Text Embeddings (Generates thousands of prompt variations instantly after 1st run) ---
TEXT_CACHE_FILE = "text_embeddings_cache_massive.pt"

if os.path.exists(TEXT_CACHE_FILE):
    print("⚡ Loading pre-computed massive text embeddings from cache (Instant Startup!)...")
    text_features = torch.load(TEXT_CACHE_FILE).to(device)
else:
    print(f"Computing ensembled text embeddings for {len(flat_labels)} massive prompt variations (Runs only once)...")
    with torch.no_grad(), torch.autocast(device_type="cuda" if torch.cuda.is_available() else "cpu", enabled=torch.cuda.is_available()):
        chunk_size = 128
        all_text_features = []
        for i in range(0, len(flat_labels), chunk_size):
            chunk = flat_labels[i:i + chunk_size]
            text_inputs = processor(text=chunk, return_tensors="pt", padding=True).to(device)
            text_outputs = model.get_text_features(
                input_ids=text_inputs["input_ids"], attention_mask=text_inputs["attention_mask"]
            )
            feat = text_outputs.text_embeds if hasattr(text_outputs, "text_embeds") else text_outputs.pooler_output
            all_text_features.append(F.normalize(feat, p=2, dim=-1))
        
        text_features = torch.cat(all_text_features, dim=0)
        num_templates = len(templates)
        num_concepts = len(text_features) // num_templates
        grouped_features = text_features.view(num_concepts, num_templates, -1).mean(dim=1)
        text_features = F.normalize(grouped_features, p=2, dim=-1)
        
        torch.save(text_features.cpu(), TEXT_CACHE_FILE)
        print("💾 Massive text embeddings cached successfully to disk!")

