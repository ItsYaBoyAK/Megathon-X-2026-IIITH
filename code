# --- 5. Discovery Helpers ---
def discover_commons_categories(labels, per_label=2):
    found = {}
    for label in labels[:3]:
        params = {
            "action": "query",
            "list": "search",
            "srsearch": label,
            "srnamespace": 14,
            "srlimit": per_label,
            "format": "json",
        }
        try:
            response = commons_session.get(COMMONS_API, params=params, timeout=5)
            response.raise_for_status()
            data = response.json()
            for item in data.get("query", {}).get("search", []):
                found[item["title"]] = item["title"]
        except requests.RequestException:
            break
    return list(found.values())

def generate_with_retry(**kwargs):
    for attempt in range(2):
        try:
            return client.models.generate_content(**kwargs)
        except ServerError:
            if attempt == 1:
                raise
            time.sleep(1)

# --- 6. Adaptive Dominance Classification Engine ---
def comprehensive_classify(input_image):
    if input_image is None:
        return "Please upload an image first.", "⚡ System standing by."

    if isinstance(input_image, str):
        image = Image.open(input_image).convert("RGB")
    else:
        image = Image.fromarray(input_image).convert("RGB")

    inputs = processor(images=image, return_tensors="pt").to(device)
    with torch.no_grad(), torch.autocast(device_type="cuda" if torch.cuda.is_available() else "cpu", enabled=torch.cuda.is_available()):
        image_outputs = model.get_image_features(pixel_values=inputs["pixel_values"])
        image_features = image_outputs.image_embeds if hasattr(image_outputs, "image_embeds") else image_outputs.pooler_output

    if not isinstance(image_features, torch.Tensor):
        image_features = image_features[0]
    image_features = F.normalize(image_features, p=2, dim=-1)

    # 1. Check Permanent Memory Bank Override
    if len(memory_bank_embeddings) > 0:
        mem_tensor = torch.stack(memory_bank_embeddings).to(device)
        mem_sims = (image_features @ mem_tensor.T).squeeze(0)
        if mem_sims.dim() == 0:
            mem_sims = mem_sims.unsqueeze(0)
        best_mem_idx = torch.argmax(mem_sims).item()
        best_mem_score = mem_sims[best_mem_idx].item()
        
        if best_mem_score > 0.80:
            cat, sub = memory_bank_labels[best_mem_idx]
            sub_str = f"➡️ **Subcategory:** `{sub}`" if sub else "*(Parent Category)*"
            result_md = f"### ⚡ Direct Edge Case Override Match\n\n- **Category:** `{cat}` {sub_str}\n- **Confidence:** **{round(best_mem_score * 100, 2)}%** *(Matched from permanent memory)*"
            return result_md, "✅ Loaded from persistent edge-case memory[cite: 1]."

    # 2. Adaptive Dominance Selection (Top 1-2 if dominant, else Top 5)
    similarities = (image_features @ text_features.T).squeeze(0)
    probabilities = (similarities * 100).softmax(dim=-1)

    top_probs, top_indices = torch.topk(probabilities, k=5)
    
    top_score = top_probs[0].item()
    second_score = top_probs[1].item()
    confidence_gap = top_score - second_score

    output_markdown = ""

    if top_score >= 50.0 or confidence_gap >= 20.0:
        k_to_show = 2 if (second_score >= top_score * 0.75 or confidence_gap < 12.0) else 1
        output_markdown += f"### ✨ Clear Dominant Match Found (Top {k_to_show})\n\n"
        
        for i in range(k_to_show):
            score = top_probs[i].item()
            idx = top_indices[i].item()
            category, subcategory = label_mapping[idx]
            sub_str = f"➡️ **Subcategory:** `{subcategory}`" if subcategory else "*(Parent Category)*"
            output_markdown += f"- **Category:** `{category}` {sub_str} — **{round(score, 2)}%**\n"
    else:
        output_markdown += "### 🔍 No clear dominant match; showing top 5 possibilities:\n\n"
        for score, idx in zip(top_probs, top_indices):
            category, subcategory = label_mapping[idx.item()]
            sub_str = f"➡️ `{subcategory}`" if subcategory else "*(Parent Category)*"
            output_markdown += f"- **{category}** {sub_str} — **{round(score.item(), 2)}%**\n"

    # 3. Gemini & Wikimedia Commons Deep Enrichment
    if client:
        try:
            label_prompt = "Return 3 short category keywords for this image as a JSON array of strings."
            label_resp = generate_with_retry(model=MODEL_NAME, contents=[label_prompt, image], config={"response_mime_type": "application/json", "response_schema": list[str]})
            labels = json.loads(label_resp.text)[:3]
            candidates = discover_commons_categories(labels, per_label=2)
            if candidates:
                output_markdown += f"\n\n### 🌐 Wikimedia Commons Discoveries:\n" + "".join(f"\n- `{c}`" for c in candidates[:4])
        except Exception:
            pass

    return output_markdown, "✅ Analysis complete[cite: 1, 2, 6]."

# --- 7. Automated Edge Case Learning Function ---
def submit_correction(current_image, correct_category, correct_subcategory):
    if current_image is None or not correct_category:
        return "⚠️ Please provide an image and a category name to save."

    if isinstance(current_image, str):
        image = Image.open(current_image).convert("RGB")
    else:
        image = Image.fromarray(current_image).convert("RGB")

    inputs = processor(images=image, return_tensors="pt").to(device)
    with torch.no_grad(), torch.autocast(device_type="cuda" if torch.cuda.is_available() else "cpu", enabled=torch.cuda.is_available()):
        image_outputs = model.get_image_features(pixel_values=inputs["pixel_values"])
        image_features = image_outputs.image_embeds if hasattr(image_outputs, "image_embeds") else image_outputs.pooler_output

    if not isinstance(image_features, torch.Tensor):
        image_features = image_features[0]
    image_features = F.normalize(image_features, p=2, dim=-1).squeeze(0)

    memory_bank_embeddings.append(image_features.cpu())
    memory_bank_labels.append((correct_category.strip(), correct_subcategory.strip() if correct_subcategory else None))

    torch.save({
        "embeddings": memory_bank_embeddings,
        "labels": memory_bank_labels
    }, MEMORY_FILE)

    return f"✅ Saved permanently to disk! Total saved edge cases: {len(memory_bank_embeddings)}[cite: 1]"

